# =====================================================================
# AuraScan AI - Brain MRI App Environment Configurations Template
# Copy this file to .env and configure settings for your local instance.
# =====================================================================

# 1. Database Configuration
DATABASE_PATH=outputs/clinical_reports.db

# 2. Deep Learning Checkpoints Paths
CLS_CHECKPOINT_PATH=models/classification/efficientnet_b0_brain_tumor.pth
SEG_CHECKPOINT_PATH=models/brain_tumor_unext/model.pth
SEG_CONFIG_PATH=models/brain_tumor_unext/config.yml

# 3. Execution Directories
REPORTS_DIR=outputs/clinical_reports
TEMP_DIR=outputs/temp_uploads

# 4. Service Port Routing & Bind Host Configurations
# Bind address to listen on. Use 127.0.0.1 for local-only development or 0.0.0.0 to listen on all interfaces (LAN).
AURASCAN_HOST=127.0.0.1
# The public/base URL that users use to access the dashboard.
# For cross-device LAN deployment, replace with http://<server-lan-ip>:5000
AURASCAN_PUBLIC_BASE_URL=http://127.0.0.1:5000
REST_PORT=8000
DASHBOARD_PORT=5000

# 5. Outbound Email & Transport Security (Phase G)
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_TIMEOUT=10
SMTP_USE_SSL=False

# App Deployment Mode
ENV_MODE=development

# 6. PII Encryption Key
# Generate a unique Fernet key (32-byte URL-safe base64 string) for production deployments.
# Example command to generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=<generate-a-unique-fernet-key>
