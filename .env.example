# =====================================================================
# AuraScan AI - Brain MRI App Environment Configurations Template
# Copy this file to .env and configure settings for your local instance.
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING REAL SECRETS TO GIT.
# =====================================================================

# 1. Environment & Runtime
ENV_MODE=development
PYTHON_VERSION=3.11.9

# 2. Database Configuration
DATABASE_PATH=outputs/clinical_reports.db
DB_PATH=outputs/clinical_reports.db

# 3. Deep Learning Checkpoints Paths
CLS_CHECKPOINT_PATH=models/classification/efficientnet_b0_brain_tumor.pth
SEG_CHECKPOINT_PATH=models/brain_tumor_unext/model.pth
SEG_CONFIG_PATH=models/brain_tumor_unext/config.yml

# 4. Execution & Runtime Storage Directories
REPORTS_DIR=outputs/clinical_reports
TEMP_DIR=outputs/temp_uploads

# 5. Service Port Routing & Bind Host Configurations
# Bind address to listen on. Use 127.0.0.1 for local-only development or 0.0.0.0 for Docker/cloud deployment.
AURASCAN_HOST=127.0.0.1
REST_PORT=8000
DASHBOARD_PORT=5000

# Public base URL used by clients/browsers to access the dashboard.
# Local development: http://127.0.0.1:5000
# LAN testing: http://<server-lan-ip>:5000
# Cloud deployment: https://<your-subdomain>.onrender.com
AURASCAN_PUBLIC_BASE_URL=http://127.0.0.1:5000

# Internal backend-to-backend URL used by Flask to communicate with FastAPI.
# Must remain loopback within the container/machine:
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000

# 6. Security & Cryptographic Secrets (Required for Production)
# JWT Secret Key for signing authentication tokens (minimum 32 characters/bytes recommended)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string

# Flask Session Secret Key for signing session cookies
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string

# PII Encryption Key for demographic field encryption (32-byte base64 URL-safe Fernet key)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=replace-with-a-fernet-key-or-use-existing-key-from-db

# Bootstrap Administrator Credentials (Required for first-boot production setup)
# When deploying to production, set a secure custom administrator password.
ADMIN_EMAIL=admin@aurascan.ai
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# 7. Outbound Email & Transport Security (Optional / Phase G)
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_TIMEOUT=10
SMTP_USE_SSL=False
